# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Lionardo <flionardo@qnx.com>
pkgname=xfce4-appfinder
pkgver=4.21.0
pkgrel=0
pkgdesc="Xfce application finder"
url="https://xfce.org/"
arch="all"
license="GPL-2.0-or-later"
depends="hicolor-icon-theme gtk3 libxfce4ui garcon"
makedepends="thunar-dev gtk3-dev libxfce4ui-dev garcon-dev intltool"
subpackages="$pkgname-lang"
replaces="xfce-utils"
source="https://archive.xfce.org/src/xfce/xfce4-appfinder/${pkgver%.*}/xfce4-appfinder-$pkgver.tar.xz"

build() {
	abuild-meson \
        	--prefix=/usr \
	. build
    	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}


sha512sums="
